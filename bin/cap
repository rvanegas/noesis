#!/bin/bash
#
# Free accounts' monthly allowances on the commons box, from the Mac.
#
#   bin/cap status            the default, the all-free cap, and every account
#                             whose allowance is raised above the default
#   bin/cap raise ann 5       adds $5 a month to ann's allowance
#   bin/cap raise ann -2      takes $2 back, never below the default
#
# Each runs scripts/accounts.py in a one-off noesis container on the box
# (SERVER.md, Phase 6), so the deployed image must carry the script, and an
# account exists only once its person has signed in. A raise is kept every
# month until changed; the all-free cap (NOESIS_FREE_MONTHLY_CAP_USD) still
# applies.
#
# The box is commons (~/src/rvanegas-site/PROJECTS.md); COMMONS_HOST overrides.
set -euo pipefail

HOST=${COMMONS_HOST:-ubuntu@32.190.173.222}
KEY=${COMMONS_KEY:-~/.ssh/lightsail-ubuntu}
SSH="ssh -i $KEY -o BatchMode=yes"

usage() {
  awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0"
}

accounts() {
  $SSH "$HOST" "cd ~/noesis && docker compose run --rm -T noesis python scripts/accounts.py $*"
}

case "${1:-}" in
  status)
    [ $# -eq 1 ] || { echo "usage: bin/cap status" >&2; exit 2; }
    accounts raised
    ;;
  raise)
    [ $# -eq 3 ] || { echo "usage: bin/cap raise <user> <usd>" >&2; exit 2; }
    user=$2 usd=$3
    # Checked here, since both go into a command line on the box.
    [[ $user =~ ^[a-z0-9][a-z0-9_-]*$ ]] || { echo "✗ not a user name: $user" >&2; exit 2; }
    [[ $usd =~ ^-?[0-9]+(\.[0-9]+)?$ ]] || { echo "✗ not an amount in dollars: $usd" >&2; exit 2; }
    accounts raise "$user" -- "$usd"
    ;;
  -h|--help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
